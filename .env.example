# ============================================================
# Binance MCP Server 环境变量配置模板
# 使用方式：复制为 .env 后按需修改（cp .env.example .env）
# 所有字段均可选，未设置时使用下方标注的默认值
# ============================================================

# ---------------- 币安凭证（行情无需，交易必填）----------------
# API Key 与 API Secret 必须成对配置；两者均留空时仅注册行情类工具
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------- 端点选择（优先级：BASE_URL > USE_DEMO > TESTNET）----------------
# 是否连接测试网（安全优先，默认 true）
BINANCE_TESTNET=true
# 是否使用 Demo 环境（真实行情 + 虚拟资金；开启时需将 BINANCE_TESTNET 设为 false）
BINANCE_USE_DEMO=false
# 自定义 API BaseURL（高级用，设置后忽略以上两个开关）
BINANCE_BASE_URL=

# ---------------- SDK 客户端参数 ----------------
# 请求超时（毫秒），覆盖 SDK 默认 1000ms
BINANCE_TIMEOUT=10000
# 失败重试次数
BINANCE_RETRIES=3
# 重试退避间隔（毫秒）
BINANCE_BACKOFF=1000
# 签名请求防重放窗口（毫秒）
# 币安校验规则：服务端时间 - 请求 timestamp < recvWindow。若本机时钟与币安服务器
# 偏差较大，签名请求会报 -1021（timestamp out of window），此时应先校准时钟，
# 或将本值适当调大（官方最大 60000）
BINANCE_RECV_WINDOW=5000

# ---------------- HTTP 代理（企业网络环境）----------------
# 格式：http://[user:pass@]host:port，留空则不启用
BINANCE_PROXY_URL=

# ---------------- MCP 服务器元数据 ----------------
MCP_SERVER_NAME=binance-mcp-server
MCP_SERVER_VERSION=3.0.0

# 启用的工具域（逗号分隔：market / trading / indicator / analysis）
# 未设置或为空 = 全部启用。非法域值会启动报错。
# 例：MCP_TOOL_DOMAINS=market,indicator   # 只启用行情与指标
MCP_TOOL_DOMAINS=

# ---------------- 日志 ----------------
# 日志级别：debug / info / warn / error（日志走 stderr，不污染 MCP stdout 协议流）
LOG_LEVEL=info
